# General
PROJECT_NAME=MCH KPI-6 Inspection Platform
ENVIRONMENT=production
AUTO_CREATE_TABLES=false
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost

# API Security
SECRET_KEY=change-this-secret-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=bcrypt

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mch_inspection
POSTGRES_USER=mch_user
POSTGRES_PASSWORD=mch_password
DATABASE_URL=postgresql+psycopg2://mch_user:mch_password@postgres:5432/mch_inspection

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mch_minio_admin
MINIO_SECRET_KEY=mch_minio_password
MINIO_SECURE=false
MINIO_BUCKET=mch-inspections
MINIO_PUBLIC_BASE_URL=http://localhost:9200

# Media limits
MAX_PHOTO_MB=8
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=15

# KPI configuration defaults
KPI6_SM_WEIGHT=0.6
KPI6_EIT_WEIGHT=0.4
KPI6_THRESHOLD_PERCENT=90
KPI6_PENALTY_PERCENT=5

# Nginx / deployment
TZ=Asia/Kolkata
