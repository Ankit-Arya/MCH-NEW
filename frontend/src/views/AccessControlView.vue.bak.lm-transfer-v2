      api.get('/access-control/bootstrap'),
      api.get('/users', { params: { include_inactive: true } })
    ])
    roles.value = bootstrap.roles || []
    users.value = allUsers || bootstrap.users || []
    stations.value = bootstrap.stations || []
    lines.value = bootstrap.lines || []
